{
  "name": "@area44/vite-emilia",
  "version": "26.04.22",
  "private": true,
  "description": "Minimalistic portfolio/photography site that features a masonry grid, page transitions, and large images",
  "author": "AREA44",
  "type": "module",
  "scripts": {
    "generate:metadata": "node scripts/generate-image-metadata.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "dev": "node --run generate:metadata && vp dev",
    "build": "node --run generate:metadata && vp build && node --run optimize:images",
    "check": "vp check --fix",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "@vitejs/plugin-react": "^6.1.1",
    "blurhash": "^2.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "satteri": "^0.10.5",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.3.3",
    "vite-plugin-satteri": "^0.3.5",
    "vite-plus": "^0.3.3"
  },
  "packageManager": "pnpm@12.6.0"
}
